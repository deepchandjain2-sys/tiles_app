import streamlit as st
import pandas as pd
import math
from datetime import datetime
from fpdf import FPDF

st.set_page_config(page_title="Jay Granite & Tiles", page_icon="🏢", layout="wide")

if "user" not in st.session_state:
    st.session_state.user = None
if "customers" not in st.session_state:
    st.session_state.customers = []
if "items" not in st.session_state:
    st.session_state.items = []

# Login Screen
if not st.session_state.user:
    st.markdown("<h2 style='color:#1e3a8a; text-align:center;'>🏢 JAY GRANITE & TILES</h2>", unsafe_allow_html=True)
    col1, col2, col3 = st.columns([1, 1.2, 1])
    with col2:
        with st.form("login"):
            u = st.text_input("Username")
            p = st.text_input("Password", type="password")
            if st.form_submit_button("Sign In", use_container_width=True, type="primary"):
                if (u == "admin" and p == "admin123") or (u in ["sales1", "sales2"] and p == "1234"):
                    st.session_state.user = {"username": u, "role": "admin" if u=="admin" else "salesman"}
                    st.rerun()
                else:
                    st.error("Invalid Credentials! (Use admin/admin123 or sales1/1234)")
    st.stop()

# Sidebar
with st.sidebar:
    st.markdown(f"### 👤 User: {st.session_state.user['username']}")
    if st.button("🚪 Logout", use_container_width=True):
        st.session_state.user = None
        st.rerun()
    st.markdown("---")
    menu = st.radio("Navigation", ["1. Register Customer", "2. Tile Selection", "3. Measurements & PDF", "4. Dashboard"])

# Module 1
if menu.startswith("1"):
    st.header("👤 Customer Registration")
    with st.form("c_reg"):
        name = st.text_input("Customer Name")
        mob = st.text_input("Mobile Number")
        addr = st.text_area("Address")
        if st.form_submit_button("Save Customer", type="primary"):
            if name and mob:
                new_id = len(st.session_state.customers) + 1
                st.session_state.customers.append({"id": new_id, "name": name, "mobile": mob, "address": addr, "salesman": st.session_state.user['username'], "status": "Shown"})
                st.success(f"Customer saved with ID #{new_id}")
            else:
                st.error("Enter Name and Mobile")

# Module 2
elif menu.startswith("2"):
    st.header("🎨 Tile Selection")
    if not st.session_state.customers:
        st.warning("Register a customer first.")
    else:
        custs = [f"#{c['id']} - {c['name']}" for c in st.session_state.customers]
        sel = st.selectbox("Choose Customer", custs)
        cid = int(sel.split()[0].replace("#", ""))
        
        with st.form("t_sel"):
            fl = st.selectbox("Floor", ["Ground Floor", "1st Floor", "2nd Floor"])
            area = st.selectbox("Area", ["Living Room", "Kitchen", "Bedroom", "Bathroom"])
            t_name = st.text_input("Tile Name / Code (e.g. 2X4 Vitrified)")
            box_sq = st.number_input("SqFt per Box", value=16.0)
            if st.form_submit_button("Add Tile", type="primary"):
                st.session_state.items.append({"cid": cid, "floor": fl, "area": area, "tile": t_name, "box_sqft": box_sq, "sqft": 100.0, "boxes": math.ceil(100.0/box_sq)})
                st.success("Tile Added!")
                
        st.subheader("Selected Items")
        curr_items = [i for i in st.session_state.items if i["cid"] == cid]
        if curr_items:
            st.dataframe(pd.DataFrame(curr_items), use_container_width=True)

# Module 3
elif menu.startswith("3"):
    st.header("📐 Measurements & PDF Quotation")
    if not st.session_state.customers:
        st.warning("No customers found.")
    else:
        custs = [f"#{c['id']} - {c['name']}" for c in st.session_state.customers]
        sel = st.selectbox("Select Customer for PDF", custs)
        cid = int(sel.split()[0].replace("#", ""))
        c_obj = next(c for c in st.session_state.customers if c["id"] == cid)
        
        items = [i for i in st.session_state.items if i["cid"] == cid]
        if items:
            for it in items:
                st.markdown(f"**{it['floor']} - {it['area']}** | Tile: `{it['tile']}`")
                it['sqft'] = st.number_input("Total Area (SqFt)", value=float(it['sqft']), key=f"sq_{it['tile']}")
                it['boxes'] = math.ceil(it['sqft'] / it['box_sqft'])
                st.caption(f"Required Boxes: **{it['boxes']}**")
                st.divider()
                
            if st.button("Generate PDF", type="primary"):
                pdf = FPDF()
                pdf.add_page()
                pdf.set_font("Helvetica", "B", 14)
                pdf.cell(0, 10, "JAY GRANITE & TILES - ESTIMATE", ln=True, align="C")
                pdf.set_font("Helvetica", "", 10)
                pdf.cell(0, 6, f"Customer: {c_obj['name']} | Mobile: {c_obj['mobile']}", ln=True)
                pdf.ln(5)
                
                pdf.set_font("Helvetica", "B", 9)
                pdf.cell(50, 7, "Area", 1)
                pdf.cell(70, 7, "Tile Name", 1)
                pdf.cell(30, 7, "Area(SqFt)", 1)
                pdf.cell(30, 7, "Boxes", 1, 1)
                
                pdf.set_font("Helvetica", "", 8)
                tot_b = 0
                for it in items:
                    tot_b += it['boxes']
                    pdf.cell(50, 6, f"{it['floor']} - {it['area']}", 1)
                    pdf.cell(70, 6, str(it['tile']), 1)
                    pdf.cell(30, 6, str(it['sqft']), 1)
                    pdf.cell(30, 6, str(it['boxes']), 1, 1)
                pdf.ln(5)
                pdf.set_font("Helvetica", "B", 10)
                pdf.cell(0, 6, f"Total Boxes Required: {tot_b}", ln=True)
                
                st.download_button("📥 Download PDF", data=bytes(pdf.output(dest='S')), file_name=f"Estimate_{c_obj['name']}.pdf", mime="application/pdf")
        else:
            st.info("No items selected for this customer.")

# Module 4
elif menu.startswith("4"):
    st.header("📊 Sales Dashboard")
    if st.session_state.customers:
        df = pd.DataFrame(st.session_state.customers)
        st.metric("Total Customers", len(df))
        st.dataframe(df, use_container_width=True)
    else:
        st.info("No data available.")
